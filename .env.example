POSTGRES_DB=luggage
POSTGRES_USER=luggage
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgres://luggage:change_me@localhost:5434/luggage?sslmode=disable
TEST_DATABASE_URL=postgres://luggage:change_me@localhost:5434/luggage_test?sslmode=disable

PORT=8080

OTP_HMAC_SECRET=replace_with_at_least_32_random_characters

DEV_OTP_PATH=/tmp/luggage-platform-dev-otp

PHONE_ENCRYPTION_KEY=base64_encoded_32_byte_key
PHONE_LOOKUP_SECRET=base64_encoded_32_byte_key

ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development
SECURE_COOKIES=false